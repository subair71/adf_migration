{
	"name": "DS_Sql_table_Parquet1",
	"properties": {
		"linkedServiceName": {
			"referenceName": "LS_ADLS_SQL_Parquet1",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"TableName": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Parquet",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": "@concat(dataset().Table_Name,'_',formatDateTime(utcNow(),'yyyyMMddHHmmss'),'.parquet'",
				"folderPath": "@concat(dataset().Table_Name,'/',formatDateTime(utcNow(),'yyyy/MM/dd’))",
				"fileSystem": "output"
			},
			"compressionCodec": "snappy"
		},
		"schema": [
			{
				"name": "id",
				"type": "UTF8"
			},
			{
				"name": "name",
				"type": "UTF8"
			},
			{
				"name": "salary",
				"type": "UTF8"
			}
		]
	}
}